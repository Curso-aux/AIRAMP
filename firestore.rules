rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── USERS COLLECTION ──────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create, update: if userId != 'admin_2' &&
                               userId != 'admin@aira.edu' &&
                               userId != 'teacher_1' &&
                               userId != 'teacher_test_1' &&
                               userId != 'john.reyes@deped.gov.ph' &&
                               userId != 'student_1' &&
                               userId != 'maria@test.com' &&
                               userId != 'T-100-0025' &&
                               !userId.matches('^S-100-010.*') &&
                               !userId.matches('^00[12]-.*') &&
                               !userId.matches('^legacy_user_.*') &&
                               !userId.matches('^student_.*') &&
                               !userId.matches('^teacher_.*') &&
                               !userId.matches('^firstlogin_.*');
      allow delete: if userId != 'A-100-0001' &&
                       userId != 'betajhoneilpoblacion@gmail.com' &&
                       !userId.matches('^SA-.*') &&
                       userId != 'super_admin_christian';
    }

    // ── SECTIONS & SUBJECTS ──────────────────────────────────
    match /sections/{sectionId} {
      allow read, write: if true;
    }

    match /subjects/{subjectId} {
      allow read, write: if true;
      
      match /modules/{moduleId} {
        allow read, write: if true;
      }

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /enrollment_keys/{keyId} {
      allow read, write: if true;
    }

    match /reg_links/{keyId} {
      allow read, write: if true;
    }

    match /curriculum_subjects/{subjectId} {
      allow read, write: if true;
    }

    // ── ANNOUNCEMENTS ─────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // ── QUIZZES & ATTEMPTS ────────────────────────────────────
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    match /quiz_assignments/{qaId} {
      allow read, write: if true;
    }

    match /quiz_attempts/{attemptId} {
      allow read, write: if true;
    }

    // ── SUBMISSIONS & ASSIGNMENTS ─────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if request.auth != null || true;
      allow write: if request.auth != null;
    }

    match /submissions/{submissionId} {
      allow read: if request.auth != null || true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── FLASHCARDS & GIZMOS ───────────────────────────────────
    match /module_flashcards/{cardId} {
      allow read, write: if true;
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ── CHAT CONVERSATIONS & MESSAGES ─────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    // ── CLASS SCHEDULES ───────────────────────────────────────
    match /class_schedules/{scheduleId} {
      allow read, write: if true;
    }

    // ── INQUIRIES & HELPDESK ─────────────────────────────────
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // ── OFFLINE HUBS & FLEET ─────────────────────────────────
    match /offline_hubs/{hubId} {
      allow read, write: if true;
    }

    // ── AUDIT LOGS ───────────────────────────────────────────
    match /system_audit_logs/{logId} {
      allow read, write: if true;
    }

    // ── MAIL & EMAIL DISPATCH AUDIT ──────────────────────────
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // ── SECURITY & PASSWORD OTPS ──────────────────────────────
    match /security_otps/{otpId} {
      allow read, write: if true;
    }

    match /password_otps/{otpId} {
      allow read, write: if true;
    }

    // ── SYSTEM CONFIGURATION ─────────────────────────────────
    match /system_config/{configId} {
      allow read, write: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── USERS COLLECTION ──────────────────────────────────────
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if userId != 'A-100-0001' &&
                       userId != 'betajhoneilpoblacion@gmail.com' &&
                       !userId.matches('^SA-.*') &&
                       userId != 'super_admin_christian';
    }

    // ── SECTIONS & SUBJECTS ──────────────────────────────────
    match /sections/{sectionId} {
      allow read, write: if true;
    }

    match /subjects/{subjectId} {
      allow read, write: if true;
      
      match /modules/{moduleId} {
        allow read, write: if true;
      }
    }

    match /curriculum_subjects/{subjectId} {
      allow read, write: if true;
    }

    // ── ANNOUNCEMENTS ─────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // ── QUIZZES & ATTEMPTS ────────────────────────────────────
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    match /quiz_assignments/{qaId} {
      allow read, write: if true;
    }

    match /quiz_attempts/{attemptId} {
      allow read, write: if true;
    }

    // ── SUBMISSIONS & ASSIGNMENTS ─────────────────────────────
    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // ── FLASHCARDS & GIZMOS ───────────────────────────────────
    match /module_flashcards/{cardId} {
      allow read, write: if true;
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // ── CHAT CONVERSATIONS & MESSAGES ─────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ── CLASS SCHEDULES ───────────────────────────────────────
    match /class_schedules/{scheduleId} {
      allow read, write: if true;
    }

    // ── INQUIRIES & HELPDESK ─────────────────────────────────
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // ── OFFLINE HUBS & FLEET ─────────────────────────────────
    match /offline_hubs/{hubId} {
      allow read, write: if true;
    }

    // ── AUDIT LOGS ───────────────────────────────────────────
    match /system_audit_logs/{logId} {
      allow read, write: if true;
    }

    // ── MAIL & EMAIL DISPATCH AUDIT ──────────────────────────
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // ── SECURITY & PASSWORD OTPS ──────────────────────────────
    match /security_otps/{otpId} {
      allow read, write: if true;
    }

    match /password_otps/{otpId} {
      allow read, write: if true;
    }
  }
}
